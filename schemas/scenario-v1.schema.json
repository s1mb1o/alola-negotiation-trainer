{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://negotiation-trainer.local/schemas/scenario-v1.schema.json",
  "title": "Negotiation Trainer Scenario v1",
  "type": "object",
  "required": [
    "scenario"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "language",
        "currency",
        "authoring_status",
        "protocol",
        "scope",
        "knowledge_model",
        "term_model",
        "roles",
        "distractors",
        "assistance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "negotiation_contract": {
          "const": "supply-package-v1"
        },
        "supply_model": {
          "$ref": "#/$defs/supplyModel"
        },
        "authoring_status": {
          "$ref": "#/$defs/authoringStatus"
        },
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "knowledge_model": {
          "$ref": "#/$defs/knowledgeModel"
        },
        "term_model": {
          "$ref": "#/$defs/termModel"
        },
        "terms": {
          "$ref": "#/$defs/terms"
        },
        "exchange_policy": {
          "$ref": "#/$defs/exchangePolicy"
        },
        "hard_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hardConstraint"
          }
        },
        "utility_model": {
          "$ref": "#/$defs/utilityModel"
        },
        "zopa": {
          "$ref": "#/$defs/zopa"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "compiler": {
          "$ref": "#/$defs/compiler"
        },
        "roles": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/role"
          }
        },
        "distractors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/distractor"
          }
        },
        "assistance": {
          "$ref": "#/$defs/assistance"
        }
      },
      "allOf": [
        {
          "if": {"required": ["negotiation_contract"]},
          "then": {"required": ["supply_model"]},
          "else": {"not": {"required": ["supply_model"]}}
        },
        {
          "if": {
            "properties": {
              "authoring_status": {
                "properties": {
                  "state": {
                    "const": "published"
                  }
                },
                "required": [
                  "state"
                ]
              }
            }
          },
          "then": {
            "required": [
              "terms",
              "hard_constraints",
              "utility_model",
              "zopa",
              "review",
              "compiler"
            ],
            "properties": {
              "authoring_status": {
                "properties": {
                  "missing_required_definitions": {
                    "maxItems": 0
                  }
                }
              },
              "protocol": {
                "required": [
                  "max_rounds"
                ]
              },
              "term_model": {
                "required": [
                  "composition_rules",
                  "evaluation_rules"
                ]
              }
            }
          }
        }
      ]
    },
    "authoringStatus": {
      "type": "object",
      "required": [
        "state",
        "missing_required_definitions"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "draft",
            "published"
          ]
        },
        "missing_required_definitions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "pass_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "pass_allowed": {
          "type": "boolean"
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "max_consecutive_clarifications": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "depth"
        ],
        "additionalProperties": false,
        "properties": {
          "depth": {
            "enum": [
              "full",
              "medium",
              "principle_only",
              "excluded"
            ]
          }
        }
      }
    },
    "knowledgeModel": {
      "type": "object",
      "required": [
        "entities"
      ],
      "additionalProperties": false,
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeEntity"
          }
        }
      }
    },
    "knowledgeEntity": {
      "type": "object",
      "required": [
        "id",
        "subject_role",
        "value_schema",
        "truth",
        "knowledge_owner_roles",
        "discoverability"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "subject_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value_schema": {
          "oneOf": [
            {
              "enum": [
                "boolean",
                "integer",
                "number",
                "string",
                "date",
                "money"
              ]
            },
            {
              "type": "object"
            }
          ]
        },
        "truth": {
          "type": "object",
          "required": [
            "source",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "authored",
                "derived",
                "authored_runtime_event"
              ]
            },
            "value": {}
          }
        },
        "knowledge_owner_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "discoverability": {
          "oneOf": [
            {
              "enum": [
                "never",
                "dialogue_evidence",
                "objective_verification"
              ]
            },
            {
              "type": "object"
            }
          ]
        },
        "disclosure_rule": {
          "type": "object"
        },
        "verification_rule": {
          "type": "object"
        },
        "sensitivity": {
          "enum": [
            "public",
            "private",
            "secret"
          ]
        }
      }
    },
    "termModel": {
      "type": "object",
      "required": [
        "primitives",
        "capabilities"
      ],
      "additionalProperties": false,
      "properties": {
        "primitives": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object"
          }
        },
        "capabilities": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/capability"
          }
        },
        "composition_rules": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/compositionRule"
          }
        },
        "evaluation_rules": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/evaluationRule"
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "primitives",
        "validators"
      ],
      "additionalProperties": false,
      "properties": {
        "subject_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "primitives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "validators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "compositionRule": {
      "type": "object",
      "required": [
        "root_type",
        "allowed_primitives",
        "validator_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "root_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "allowed_primitives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "validator_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "evaluationRule": {
      "type": "object",
      "required": [
        "applies_to_roles",
        "input_types",
        "expression"
      ],
      "additionalProperties": false,
      "properties": {
        "applies_to_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "input_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "expression": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "terms": {
      "type": "object",
      "required": [
        "definitions",
        "required_term_ids",
        "optional_term_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "definitions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "value_schema",
              "evaluation_rule_ids"
            ],
            "properties": {
              "value_schema": {
                "type": "object"
              },
              "evaluation_rule_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "required_term_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "optional_term_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hardConstraint": {
      "type": "object",
      "required": [
        "id",
        "applies_to_role",
        "expression"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "applies_to_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "expression": {
          "type": "object"
        },
        "violation_code": {
          "type": "string"
        }
      }
    },
    "utilityModel": {
      "type": "object",
      "required": [
        "normalization",
        "role_models"
      ],
      "additionalProperties": false,
      "properties": {
        "normalization": {
          "type": "object",
          "required": [
            "minimum",
            "maximum"
          ],
          "additionalProperties": false,
          "properties": {
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            }
          }
        },
        "role_models": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "object",
            "required": [
              "reservation_utility",
              "aggregation",
              "value_functions"
            ],
            "properties": {
              "reservation_utility": {
                "type": "number"
              },
              "aggregation": {
                "enum": [
                  "weighted_sum",
                  "piecewise_weighted_sum",
                  "supply-economics-v1"
                ]
              },
              "value_functions": {
                "type": "object"
              }
            },
            "allOf": [{
              "if": {"properties": {"aggregation": {"const": "supply-economics-v1"}}},
              "then": {"properties": {"value_functions": {"maxProperties": 0}}},
              "else": {"properties": {"value_functions": {"minProperties": 1}}}
            }],
            "additionalProperties": true
          }
        }
      }
    },
    "supplyModel": {
      "type": "object",
      "required": ["version", "evaluator_version", "calendar", "capabilities", "bounds", "reserve_rules", "economics", "npc_policy"],
      "additionalProperties": false,
      "properties": {
        "version": {"const": "supply-package-v1"},
        "evaluator_version": {"const": "supply-economics-v1"},
        "calendar": {
          "type": "object",
          "required": ["negotiation_date", "timezone", "earliest_date", "earliest_full_date", "latest_date", "early_november_start", "early_november_end", "integration_deadline", "completion_deadline"],
          "additionalProperties": false,
          "properties": {
            "negotiation_date": {"type": "string", "format": "date"},
            "timezone": {"type": "string"},
            "earliest_date": {"type": "string", "format": "date"},
            "earliest_full_date": {"type": "string", "format": "date"},
            "latest_date": {"type": "string", "format": "date"},
            "early_november_start": {"type": "string", "format": "date"},
            "early_november_end": {"type": "string", "format": "date"},
            "integration_deadline": {"type": "string", "format": "date"},
            "completion_deadline": {"type": "string", "format": "date"}
          }
        },
        "capabilities": {
          "type": "object",
          "required": ["main_quantity", "max_lots", "max_early_quantity", "max_reserve_quantity", "lot_ids", "delivery_basis", "destination_id", "balance_days"],
          "additionalProperties": false,
          "properties": {
            "main_quantity": {"type": "integer", "minimum": 2},
            "max_lots": {"const": 2},
            "max_early_quantity": {"type": "integer", "minimum": 1},
            "max_reserve_quantity": {"type": "integer", "minimum": 1, "maximum": 3},
            "lot_ids": {"const": ["main", "early", "remaining"]},
            "delivery_basis": {"const": "DDP"},
            "destination_id": {"const": "vector_site"},
            "balance_days": {"const": [0, 30]}
          }
        },
        "bounds": {
          "type": "object", "additionalProperties": false,
          "required": ["base_price_min_minor", "base_price_max_minor"],
          "properties": {
            "base_price_min_minor": {"type": "integer", "minimum": 1},
            "base_price_max_minor": {"type": "integer", "minimum": 1}
          }
        },
        "reserve_rules": {
          "type": "object", "additionalProperties": false,
          "required": ["use_cutoff", "unused_payable_on", "diagnosis_days", "unit_price_rule", "diagnosis_policy_id", "inconclusive_deadline_outcome", "hardware_precedence"],
          "properties": {
            "use_cutoff": {"type": "string", "format": "date"},
            "unused_payable_on": {"type": "string", "format": "date"},
            "diagnosis_days": {"type": "integer", "minimum": 1, "maximum": 60},
            "unit_price_rule": {"const": "base_unit_ceil"},
            "diagnosis_policy_id": {"const": "hardware-replacement-v1"},
            "inconclusive_deadline_outcome": {"const": "free"},
            "hardware_precedence": {"const": true}
          }
        },
        "economics": {
          "type": "object", "additionalProperties": false,
          "required": ["buyer", "seller", "utility_divisor_minor"],
          "properties": {
            "utility_divisor_minor": {"type": "integer", "minimum": 1},
            "buyer": {
              "type": "object", "additionalProperties": false,
              "required": ["maximum_liability_minor", "comparison_value_minor", "integration_value_minor", "completion_value_minor", "financing_cost_minor", "reserve_value_per_unit_minor", "delayed_balance_benefit_minor"],
              "properties": {
                "maximum_liability_minor": {"type": "integer", "minimum": 0},
                "comparison_value_minor": {"type": "integer", "minimum": 0},
                "integration_value_minor": {"type": "integer", "minimum": 0},
                "completion_value_minor": {"type": "integer", "minimum": 0},
                "financing_cost_minor": {"type": "integer", "minimum": 0},
                "reserve_value_per_unit_minor": {"type": "integer", "minimum": 0},
                "delayed_balance_benefit_minor": {"type": "integer", "minimum": 0}
              }
            },
            "seller": {
              "type": "object", "additionalProperties": false,
              "required": ["minimum_base_price_minor", "base_cost_minor", "split_cost_minor", "acceleration_cost_per_unit_minor", "financing_credit_minor", "reserve_cost_per_unit_minor", "delayed_balance_cost_minor"],
              "properties": {
                "minimum_base_price_minor": {"type": "integer", "minimum": 0},
                "base_cost_minor": {"type": "integer", "minimum": 0},
                "split_cost_minor": {"type": "integer", "minimum": 0},
                "acceleration_cost_per_unit_minor": {"type": "integer", "minimum": 0},
                "financing_credit_minor": {"type": "integer", "minimum": 0},
                "reserve_cost_per_unit_minor": {"type": "integer", "minimum": 0},
                "delayed_balance_cost_minor": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "npc_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["price_candidates_minor", "standard_price_index", "advance_price_index", "split_price_index", "advance_threshold_bps"],
          "properties": {
            "price_candidates_minor": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
            "standard_price_index": {"type": "integer", "minimum": 0},
            "advance_price_index": {"type": "integer", "minimum": 0},
            "split_price_index": {"type": "integer", "minimum": 0},
            "advance_threshold_bps": {"type": "integer", "minimum": 0, "maximum": 10000}
          }
        }
      }
    },
    "zopa": {
      "type": "object",
      "required": [
        "expected_condition",
        "training_intent"
      ],
      "additionalProperties": false,
      "properties": {
        "expected_condition": {
          "enum": [
            "non_empty",
            "empty",
            "not_constrained"
          ]
        },
        "training_intent": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "reveal_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "reveal_policy": {
          "type": "object"
        }
      }
    },
    "compiler": {
      "type": "object",
      "required": [
        "schema_version",
        "compiler_version"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dialogueReason": {
      "description": "A qualitative authored explanation. The engine may disclose this text on a matching topic question. The private source is never renderer context.",
      "type": "object",
      "required": ["id", "term_id", "text", "source_ref", "disclose_when"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 100
        },
        "term_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Plain nonnumeric text. The publication compiler rejects numbers, dates, currencies, credential fragments, control characters, and markup. The author is responsible for semantic grounding in source_ref."
        },
        "source_ref": {
          "enum": ["brief.objective", "brief.context"]
        },
        "disclose_when": {
          "const": "on_topic_question"
        }
      }
    },
    "exchangePolicy": {
      "type": "object",
      "required": ["candidate_values"],
      "additionalProperties": false,
      "properties": {
        "candidate_values": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 12,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "number"}
          }
        }
      }
    },
    "role": {
      "type": "object",
      "required": [
        "company",
        "batna",
        "constraints",
        "interests"
      ],
      "additionalProperties": false,
      "properties": {
        "company": {
          "type": "string",
          "minLength": 1
        },
        "brief": {
          "type": "object"
        },
        "conversation_style": {
          "enum": ["pragmatic", "analytical", "relationship_focused"]
        },
        "dialogue_reasons": {
          "type": "array",
          "maxItems": 6,
          "items": {"$ref": "#/$defs/dialogueReason"}
        },
        "opening_offer": {
          "description": "A complete authored opening offer. Published scenarios must include every required term.",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "object"
            }
          ]
        },
        "opening_position": {
          "description": "A non-empty authored opening position. Omitted required terms remain unresolved and cannot bind.",
          "type": "object",
          "minProperties": 1
        },
        "batna": {
          "type": "object",
          "required": [
            "utility"
          ],
          "properties": {
            "utility": {
              "type": "number"
            }
          },
          "additionalProperties": true
        },
        "constraints": {
          "type": "object",
          "required": [
            "reservation_utility"
          ],
          "properties": {
            "reservation_utility": {
              "type": "number"
            }
          },
          "additionalProperties": true
        },
        "interests": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "known_capabilities": {
          "type": "object"
        }
      }
    },
    "distractor": {
      "type": "object",
      "required": [
        "id",
        "type",
        "content",
        "truth_note",
        "audience_role",
        "delivery_condition"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "wrong_opinion",
            "outdated",
            "contradictory",
            "irrelevant"
          ]
        },
        "content": {
          "type": "string"
        },
        "truth_note": {
          "type": "string"
        },
        "audience_role": {
          "type": "string"
        },
        "delivery_condition": {
          "type": "object"
        },
        "canonical_reference": {
          "type": "string"
        },
        "paraphrasing_allowed": {
          "type": "boolean"
        }
      }
    },
    "assistance": {
      "type": "object",
      "required": [
        "guided",
        "easy",
        "normal",
        "expert"
      ],
      "additionalProperties": false,
      "properties": {
        "guided": {
          "$ref": "#/$defs/assistanceMode"
        },
        "easy": {
          "$ref": "#/$defs/assistanceMode"
        },
        "normal": {
          "$ref": "#/$defs/assistanceMode"
        },
        "expert": {
          "$ref": "#/$defs/assistanceMode"
        }
      }
    },
    "assistanceMode": {
      "type": "object",
      "required": [
        "expose_actor_priorities",
        "show_detected_signals",
        "show_coaching"
      ],
      "additionalProperties": false,
      "properties": {
        "expose_actor_priorities": {
          "type": "boolean"
        },
        "show_detected_signals": {
          "type": "boolean"
        },
        "show_coaching": {
          "type": "boolean"
        },
        "distractor_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

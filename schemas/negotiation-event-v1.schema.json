{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://negotiation-trainer.local/schemas/negotiation-event-v1.schema.json",
  "title": "Negotiation Event v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "seq",
    "session_revision",
    "command_id",
    "causation_id",
    "timestamp",
    "round",
    "participant_id",
    "role",
    "type",
    "language",
    "visibility",
    "raw_message",
    "extractor_output",
    "validation",
    "state_effect"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fixture_purpose": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "$ref": "#/$defs/id"
    },
    "session_id": {
      "$ref": "#/$defs/id"
    },
    "origin_session_id": {
      "$ref": "#/$defs/id"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "session_revision": {
      "type": "integer",
      "minimum": 1
    },
    "command_id": {
      "$ref": "#/$defs/id"
    },
    "causation_id": {
      "$ref": "#/$defs/id"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "participant_id": {
      "$ref": "#/$defs/id"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "visibility": {
      "enum": [
        "internal",
        "public",
        "participant"
      ]
    },
    "raw_message": {
      "type": "string"
    },
    "extractor_output": {
      "$ref": "#/$defs/extractorOutput"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "state_effect": {
      "$ref": "#/$defs/stateEffect"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "extractorOutput": {
      "type": "object",
      "required": [
        "speech_acts",
        "proposed_action",
        "proposed_runtime_terms",
        "proposed_evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "speech_acts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "proposed_action": {
          "type": "string"
        },
        "proposed_runtime_terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeTerm"
          }
        },
        "proposed_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "proposed_hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hypothesisProposal"
          }
        }
      }
    },
    "runtimeTerm": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "knowledge_item_id",
        "observer_participant_id",
        "signal",
        "strength",
        "source_span",
        "source_event_id"
      ],
      "additionalProperties": false,
      "properties": {
        "knowledge_item_id": {
          "type": "string"
        },
        "observer_participant_id": {
          "$ref": "#/$defs/id"
        },
        "signal": {
          "enum": [
            "positive",
            "negative",
            "neutral",
            "contradictory"
          ]
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_span": {
          "type": "string"
        },
        "source_event_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "hypothesisProposal": {
      "type": "object",
      "required": [
        "subject",
        "predicate",
        "signal",
        "strength",
        "source_span",
        "source_event_id"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "signal": {
          "type": "string"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_span": {
          "type": "string"
        },
        "source_event_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "action",
        "runtime_terms",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/validationResult"
        },
        "runtime_terms": {
          "$ref": "#/$defs/validationResult"
        },
        "evidence": {
          "$ref": "#/$defs/validationResult"
        },
        "hypotheses": {
          "$ref": "#/$defs/validationResult"
        }
      }
    },
    "validationResult": {
      "enum": [
        "accepted",
        "rejected",
        "clarification_required",
        "structurally_valid_unscored"
      ]
    },
    "stateEffect": {
      "type": "object",
      "required": [
        "offer",
        "offer_lifecycle_changes",
        "next_actor_after",
        "substantive_turn_count_before",
        "substantive_turn_count_after",
        "round_before",
        "round_after",
        "hypothesis_creations",
        "belief_updates"
      ],
      "additionalProperties": false,
      "properties": {
        "offer": {
          "$ref": "#/$defs/offerRevision"
        },
        "offer_lifecycle_changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/offerLifecycleChange"
          }
        },
        "next_actor_after": {
          "$ref": "#/$defs/id"
        },
        "substantive_turn_count_before": {
          "type": "integer",
          "minimum": 0
        },
        "substantive_turn_count_after": {
          "type": "integer",
          "minimum": 0
        },
        "round_before": {
          "type": "integer",
          "minimum": 1
        },
        "round_after": {
          "type": "integer",
          "minimum": 1
        },
        "hypothesis_creations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hypothesisCreation"
          }
        },
        "belief_updates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/beliefUpdate"
          }
        }
      }
    },
    "offerRevision": {
      "type": "object",
      "required": [
        "offer_id",
        "offer_revision",
        "base_offer_id",
        "base_offer_revision",
        "materialized_terms",
        "unresolved_required_terms"
      ],
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "$ref": "#/$defs/id"
        },
        "offer_revision": {
          "type": "integer",
          "minimum": 1
        },
        "base_offer_id": {
          "$ref": "#/$defs/id"
        },
        "base_offer_revision": {
          "type": "integer",
          "minimum": 1
        },
        "materialized_terms": {
          "type": "object"
        },
        "unresolved_required_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "offerLifecycleChange": {
      "type": "object",
      "required": [
        "offer_id",
        "offer_revision",
        "status_before",
        "status_after"
      ],
      "additionalProperties": false,
      "properties": {
        "offer_id": {
          "$ref": "#/$defs/id"
        },
        "offer_revision": {
          "type": "integer",
          "minimum": 1
        },
        "status_before": {
          "oneOf": [
            {
              "$ref": "#/$defs/offerStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "status_after": {
          "$ref": "#/$defs/offerStatus"
        }
      }
    },
    "offerStatus": {
      "enum": [
        "active",
        "superseded",
        "withdrawn",
        "rejected",
        "accepted",
        "expired",
        "closed_by_termination"
      ]
    },
    "beliefUpdate": {
      "type": "object",
      "required": [
        "observer_participant_id",
        "confidence_before",
        "confidence_after",
        "evidence_event_ids",
        "update_policy_version"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "knowledge_item_id"
          ]
        },
        {
          "required": [
            "hypothesis_id"
          ]
        }
      ],
      "properties": {
        "observer_participant_id": {
          "$ref": "#/$defs/id"
        },
        "knowledge_item_id": {
          "type": "string"
        },
        "hypothesis_id": {
          "$ref": "#/$defs/id"
        },
        "confidence_before": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_after": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "update_policy_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hypothesisCreation": {
      "type": "object",
      "required": [
        "hypothesis_id",
        "observer_participant_id",
        "subject",
        "predicate",
        "grounded_in_scenario",
        "initial_confidence",
        "evidence_event_ids",
        "update_policy_version"
      ],
      "additionalProperties": false,
      "properties": {
        "hypothesis_id": {
          "$ref": "#/$defs/id"
        },
        "observer_participant_id": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "grounded_in_scenario": {
          "const": false
        },
        "initial_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "update_policy_version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

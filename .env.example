# External-agent clients and the optional backend NPC renderer read these variables at runtime.
# Keep every credential in the process environment.
OPENAI_API_KEY=
QWEN_API_KEY=
# Selected Pay-as-you-go credential. Export it from ~/.zshrc; do not put its value here.
# The live launcher uses this variable for all three model routes.
QWENCLOUD_PAYGO_API_KEY=
# External-agent clients use this value for Coding Plan or a custom QwenCloud workspace endpoint.
# External-agent clients select the Token Plan endpoint automatically for `sk-sp-` keys.
# QWEN_BASE_URL=https://coding-intl.dashscope.aliyuncs.com/v1

# Built-in NPC dialogue rendering.
# The default template mode makes no provider request and needs no credential.
# Allowed values: template, openai, qwen.
# Use scripts/run-qwen-api.zsh for the selected task-specific Pay-as-you-go configuration.
NEGOTIATION_NPC_PROVIDER=template
# OpenAI defaults to gpt-5.6-luna when this value is empty.
# Qwen NPC rendering defaults to qwen3.8-max when this value is empty.
NEGOTIATION_NPC_MODEL=
# Use only uppercase letters, digits, and underscores in this environment-variable name.
# Leave empty to use OPENAI_API_KEY or QWEN_API_KEY for the selected provider.
NEGOTIATION_NPC_API_KEY_ENV=
# Leave empty to use OpenAI's standard endpoint or the Qwen Token Plan endpoint.
# A custom endpoint must use HTTPS and requires an explicit key environment-variable name.
NEGOTIATION_NPC_BASE_URL=
# Permitted range: 32 through 2000.
NEGOTIATION_NPC_MAX_OUTPUT_TOKENS=300
# Optional. Leave empty for gpt-5.6-luna. When supported, the permitted range is 0 through 2.
NEGOTIATION_NPC_TEMPERATURE=
# Optional. Use false for hybrid models when dialogue does not need hidden reasoning.
NEGOTIATION_NPC_ENABLE_THINKING=
# Permitted range: 0.1 through 120 seconds.
NEGOTIATION_NPC_TIMEOUT_SECONDS=20

# Optional control profile. Empty values reuse the NPC provider.
NEGOTIATION_CONTROL_PROVIDER=
NEGOTIATION_CONTROL_MODEL=
NEGOTIATION_CONTROL_API_KEY_ENV=
NEGOTIATION_CONTROL_BASE_URL=
NEGOTIATION_CONTROL_TEMPERATURE=
NEGOTIATION_CONTROL_ENABLE_THINKING=
NEGOTIATION_CONTROL_TIMEOUT_SECONDS=20

# Optional final-review profile. Empty values reuse the control provider.
NEGOTIATION_REVIEW_PROVIDER=
NEGOTIATION_REVIEW_MODEL=
NEGOTIATION_REVIEW_API_KEY_ENV=
NEGOTIATION_REVIEW_BASE_URL=
NEGOTIATION_REVIEW_TEMPERATURE=
NEGOTIATION_REVIEW_ENABLE_THINKING=
NEGOTIATION_REVIEW_TIMEOUT_SECONDS=45
# Optional supply-message normalization through the configured NPC provider.
# Adds at most two provider calls before rendering. False preserves the offline bounded parser.
NEGOTIATION_SUPPLY_SEMANTIC_EXTRACTION=false

# Local development defaults.
NEGOTIATION_API_URL=http://127.0.0.1:8172
NEGOTIATION_DB_PATH=backend/data/negotiation.db
NEGOTIATION_ADMIN_TOKEN=
# Vite proxies /api to this target when VITE_API_BASE is not set.
VITE_API_PROXY_TARGET=http://127.0.0.1:8172
VITE_DEV_PORT=8171
# Provider-only browser controls are hidden unless this is true at build time.
VITE_ENABLE_PROVIDER_FEATURES=false
# Add directories with the platform path separator when needed.
# NEGOTIATION_SCENARIO_DIR=/absolute/path/to/scenarios

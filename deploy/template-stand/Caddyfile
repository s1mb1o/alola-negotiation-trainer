# The API enforces AdministratorBearer. All other admin routes remain blocked.
@training_presets {
  method GET
  path /api/v1/admin/training-presets
}
handle @training_presets {
  header X-Robots-Tag "noindex, nofollow"
  header Cache-Control "no-store"
  reverse_proxy 127.0.0.1:8172
}

@blocked path /llm-debug* /api/v1/admin/*
handle @blocked {
  header X-Robots-Tag "noindex, nofollow"
  respond "Forbidden" 403
}

handle /api/* {
  header X-Robots-Tag "noindex, nofollow"
  reverse_proxy 127.0.0.1:8172
}

@root path /
redir @root /ru/ 308

@ru_without_slash path /ru
redir @ru_without_slash /ru/ 308

@en_without_slash path /en
redir @en_without_slash /en/ 308

@jury_resources path /hackaton /hackaton/* /presentation /presentation/
header @jury_resources {
  X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  Cache-Control "no-store"
  Referrer-Policy "no-referrer"
}

@hackaton_without_slash path /hackaton
redir @hackaton_without_slash /hackaton/ 308

@old_training path /training /training/
redir @old_training /app/training 308

@old_progress path /progress /progress/
redir @old_progress /app/progress 308

@old_inspector path /inspector /inspector/
redir @old_inspector /app/inspector 308

@app_root path /app /app/
redir @app_root /app/training 308

handle /assets/* {
  header Cache-Control "public, max-age=31536000, immutable"
  root * /opt/negotiation-trainer/frontend/dist
  file_server
}

@sitemap path /sitemap.xml
handle @sitemap {
  header Cache-Control "public, max-age=3600"
  header Content-Type "application/xml; charset=utf-8"
  root * /opt/negotiation-trainer/frontend/dist
  file_server
}

@manifest path /site.webmanifest
handle @manifest {
  header Cache-Control "public, max-age=3600"
  header Content-Type "application/manifest+json; charset=utf-8"
  root * /opt/negotiation-trainer/frontend/dist
  file_server
}

@public_files path /landing.css /hackaton.css /favicon.svg /og/* /robots.txt /version.txt
handle @public_files {
  header Cache-Control "public, max-age=3600"
  root * /opt/negotiation-trainer/frontend/dist
  file_server
}

@presentation path /presentation /presentation/
handle @presentation {
  root * /opt/negotiation-trainer/frontend/dist
  rewrite * /hackaton/alola-presentation-v6.pdf
  header Content-Disposition "inline; filename=ALOLA-LCT2026.pdf"
  file_server
}

handle /hackaton/* {
  root * /opt/negotiation-trainer/frontend/dist
  file_server
}

@marketing path /ru/* /en/*
handle @marketing {
  header Cache-Control "public, max-age=300"
  root * /opt/negotiation-trainer/frontend/dist
  file_server
}

handle /app/* {
  header X-Robots-Tag "noindex, nofollow"
  root * /opt/negotiation-trainer/frontend/dist
  try_files {path} /index.html
  file_server
}

handle {
  respond "Not Found" 404
}
